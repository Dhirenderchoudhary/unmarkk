{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@unmarkk/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "*.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["**/dist/**", "node_modules", "packages/web"]
}
