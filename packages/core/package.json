{
  "name": "@unmarkk/core",
  "version": "1.0.4",
  "description": "Privacy-first watermark and metadata removal engine. Zero dependencies, runs in Node and the browser.",
  "license": "MIT",
  "author": "Dhirender Choudhary",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "keywords": [
    "privacy",
    "metadata",
    "exif",
    "watermark",
    "c2pa",
    "unicode",
    "zero-width",
    "local-first"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhirenderchoudhary/unmarkk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Dhirenderchoudhary/unmarkk#readme",
  "bugs": {
    "url": "https://github.com/Dhirenderchoudhary/unmarkk/issues"
  },
  "engines": {
    "node": ">=20.11"
  }
}
